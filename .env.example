# Host paths. Relative paths are resolved from the repository root.
MOTION_EXCHANGE_HOST=../motion_exchange
MOTION_MODELS_HOST=../motion_models
UNITREE_SDK2_PYTHON_HOST=../unitree_sdk2_python
SOCIALNAV_WORKSPACE_HOST=..
GROOT_WBC_HOST=./vendor/GR00T-WholeBodyControl
HF_CACHE_HOST=/home/adcs-public-robot/.cache/huggingface
ISAAC_SIM_CACHE_ROOT=/home/adcs-public-robot/docker/isaac-sim

# DDS discovery used by the JSON command/status plane.
MOTION_DDS_INTERFACE=lo

# Qualified default runtime selection.
SONIC_ASSET_PROFILE=g1_deployment_v1
SONIC_ISAAC_TASK=Isaac-Flat-G129-Deployment-V1
ISAAC_RUNNER_ASSET_PROFILE=g1_deployment_v1
ISAAC_RUNNER_TASK=Isaac-Flat-G129-Deployment-V1
